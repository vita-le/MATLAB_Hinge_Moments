function Geo = GeoInput(ID)


if ID == 18 
   
    % =================================================================
    %                   F/A-18 GEOMETRY INPUT
    % https://man.fas.org/dod-101/sys/ac/f-18.htm?level=1&utm  SOURCE
    % =================================================================

    %-------------------------- ROSKAM -----------------------------------
   
    Geo.b          = 12.31;                                                % Full Span
    Geo.S          = 37.16;                                                % Full wing surface [m^2]
    Geo.Lambda     = 35;                                                   % LE sweep [deg]
    Geo.c_r        = 4.04;                                                 % root chord
    Geo.c_t        = 1.68;                                                 % tip chord
    Geo.TR_full    = Geo.c_t / Geo.c_r;                                    % Taper ratio of wing

    Geo.S_f        = 2.27 / 2;                                             % 1 aileron surface area (total /2 for each aileron)
    Geo.hinge      = 0.25;                                                 % hinge line position
    Geo.y_i        = 4.03;                                                 % inner spanwise station
    Geo.y_o        = 5.87;                                                 % outer spanwise station
    Geo.bf         = Geo.y_o - Geo.y_i;                                    % span aileron (preliminary (not used in calculations later)) 


    y_mid = (Geo.y_i + Geo.y_o)/2;            % middle aileron
    c_local = 4.04 - ...
          (4.04 - 1.68) * ...
          (y_mid / (12.31/2));                % wing chord at middle of aileron
    c_aileron = Geo.S_f / Geo.bf;                 % MAC chord aileron 

    %-------------------------- TORNADO -----------------------------------
   
    Geo.name       = 'F/A-18';                                             % name assigned to Geometry
    
    % Center of Gravity
    Geo.x_CG      = 0;                                                     % CG x coord
    Geo.y_CG      = 0;                                                     % CG y coord
    Geo.z_CG      = 0;                                                     % CG z coord

    % Reference Point
    Geo.x_ref = 0;                                                         % coord x
    Geo.y_ref = 0;                                                         % coord y 
    Geo.z_ref = 0;                                                         % coord z

    Geo.nwing = (1);                                                       % Number of wings (wing, V tail, H tail, fuse)
    Geo.nelem = (2);                                                       % Partitions of each wing

    Geo.symetric = 1;                                                      % Mirrored y-n for each wing


    Geo.startx = [0, (Geo.b/2 - Geo.bf)*tand(Geo.Lambda)];                     % apex point x coord for each part of each wing
    Geo.starty = [0, (Geo.b/2 - Geo.bf)];                                  % apex point y coord for each part of each wing
    Geo.startz = [0, 0];                                                   % apex point z coord for each part of each wing


    Geo.allmove = (0);                                                     % y-n for each wing

    Geo.c_root          = 4.04;                                            % root chords for each wing
    Geo.Airfoil_root    = 'N64210.DAT';                                    % root airfoil for each partition
    Geo.Airfoil_tip     = 'N64210.DAT';                                    % tip airfoil

    % Panels distribution
    Geo.nx         = 3;                                                    % Chord-wise number of panels (FIXED)
    Geo.ny         = 7;                                                    % Span-wise number of panels  (FIXED)
    Geo.fnx        = 2;                                                    % Chord-wise number of panels for flap
    Geo.fny        = 4;                                                    % Span-wise number of panels for flap
    Geo.meshtype   = [1, 1];                                               % mesh type 1 to 7

    Geo.Twist      = 0;                                                    % wing twist angle [deg]
    Geo.Gamma      = -3;                                                   % dihedral [deg]
  
    Geo.span       = [Geo.b/2 - Geo.bf, Geo.bf];                           % span for each partition [(full b/2 -  bf) , bf ] 
    Geo.TR       = [2.38/Geo.c_root, Geo.c_t/2.38];                        % Taper ratio for each partition
    Geo.Lambda_c4  = [20, 20];                                             % sweep at 1/4 chord for each part [deg]

    Geo.flapped    = [0, 1];                                               % is partition flapped?

    Geo.fc         = c_aileron / c_local;                                  % flap chord ratio
    Geo.fsym       = [0, 1];                                               % Sym deflection of flap ? y-n for each wing and part

    %---------------------------------------------------------------------


elseif ID == 18.1

    % =================================================================
    %                   F/A-18 GEOMETRY INPUT including tail 
    % https://man.fas.org/dod-101/sys/ac/f-18.htm?level=1&utm  SOURCE
    % =================================================================

    %-------------------------- ROSKAM -----------------------------------

    Geo.b          = 12.31;                                                % Full Span
    Geo.S          = 37.16;                                                % Full wing surface [m^2]
    Geo.Lambda     = 35;                                                   % LE sweep [deg]
    Geo.c_r        = 4.04;                                                 % root chord
    Geo.c_t        = 1.68;                                                 % tip chord
    Geo.TR_full    = Geo.c_t / Geo.c_r;                                    % Taper ratio of wing

    Geo.S_f        = 2.27 / 2;                                             % 1 aileron surface area (total /2 for each aileron)
    Geo.hinge      = 0.25;                                                 % hinge line position
    Geo.y_i        = 4.03;                                                 % inner spanwise station
    Geo.y_o        = 5.87;                                                 % outer spanwise station
    Geo.bf         = Geo.y_o - Geo.y_i;                                    % span aileron (preliminary (not used in calculations later)) 

    %----------------------------------------------------------------------
    y_mid = (Geo.y_i + Geo.y_o)/2;            % middle aileron
    c_local = 4.04 - ...
          (4.04 - 1.68) * ...
          (y_mid / (12.31/2));                % wing chord at middle of aileron
    c_aileron = Geo.S_f / Geo.bf;                 % MAC chord aileron 

    %-------------------------- TORNADO -----------------------------------

    Geo.name       = 'F/A-18 TAIL';                                        % name assigned to Geometry

    % Center of Gravity
    Geo.x_CG      = 0;                                                     % CG x coord
    Geo.y_CG      = 0;                                                     % CG y coord
    Geo.z_CG      = 0;                                                     % CG z coord

    % Reference Point
    Geo.x_ref = 0;                                                         % coord x
    Geo.y_ref = 0;                                                         % coord y 
    Geo.z_ref = 0;                                                         % coord z

    Geo.nwing = 3;                                                         % Number of wings (wing, H tail, V tail)
    Geo.nelem = [2, 1, 1];                                                 % Partitions of each wing

    Geo.symetric = [1, 1, 1];                                              % Mirrored y-n for each wing


    Geo.startx = [0, (Geo.b/2 - Geo.bf)*tand(Geo.Lambda);
                  5.05, 0;
                  3.23, 0];                                                % apex point x coord for each part of each wing

    Geo.starty = [0, (Geo.b/2 - Geo.bf); 
                  0, 0; 
                  1.16, 0];                                                % apex point y coord for each part of each wing

    Geo.startz = [0, 0; 
                  0, 0; 
                  0, 0];                                                   % apex point z coord for each part of each wing


    Geo.allmove = [0, 0, 0];                                               % y-n for each wing

    Geo.c_root          = [4.04, 3.1, 2.98];                                % root chords for each wing
    Geo.Airfoil_root    = 'N64210.DAT';                                    % root airfoil for each partition
    Geo.Airfoil_tip     = 'N64210.DAT';                                    % tip airfoil
    Geo.Airfoil_tail    = 'naca0018';                                      % sym airfoil for tail

Geo.Airfoil = {
    'N64210.DAT', 'N64210.DAT';
    'naca0018.DAT',   'naca0018.DAT';
    'naca0018.DAT',   'naca0018.DAT'
};


    % Panels distribution
    Geo.nx         = 3;                                                    % Chord-wise number of panels (FIXED)
    Geo.ny         = 7;                                                    % Span-wise number of panels  (FIXED)
    Geo.fnx        = 2;                                                    % Chord-wise number of panels for flap
    Geo.fny        = 4;                                                    % Span-wise number of panels for flap
    Geo.meshtype   = [1, 1; 1, 1; 1, 1];                                   % mesh type 1 to 7

    Geo.Twist      = 0;                                                    % wing twist angle [deg]
    Geo.Gamma      = [-3, -3; 0, 0; 70, 0];                                 % dihedral [deg]

    Geo.span       = [Geo.b/2 - Geo.bf, Geo.bf; 6.58/2, 0; 3, 0];          % span for each partition [(full b/2 -  bf) , bf ] 
    Geo.TR       = [2.38/Geo.c_root(1), Geo.c_t/2.38; 0.33, 0; 0.3, 0];    % Taper ratio for each partition
    Geo.Lambda_c4  = [20, 20; 40, 0; 35, 0];                               % sweep at 1/4 chord for each part [deg]

    Geo.flapped    = [0, 1; 0, 0; 0, 0];                                   % is partition flapped?

    Geo.fc         = c_aileron / c_local;                                  % flap chord ratio
    Geo.fsym       = [0, 1];                                               % Sym deflection of flap ? y-n for each wing and part

    %---------------------------------------------------------------------

end