        <matlabID>18.1</matlabID>
        <source>https://man.fas.org/dod-101/sys/ac/f-18.htm</source>
        <notes>The field names below intentionally match the MATLAB Geo struct. Semicolon-separated values are row vectors or cell arrays.</notes>
        <geo>
          <!-- 1. Wing parameters -->
          <name>F/A-18 TAIL</name>
          <b units="m">12.31</b>
          <S units="m2">37.16</S>
          <Lambda units="deg">35</Lambda>
          <c_r units="m">4.04</c_r>
          <c_t units="m">1.68</c_t>
          <TR_full>0.415841584158416</TR_full>

          <!-- 2. Aileron parameters -->
          <S_f units="m2">1.135</S_f>
          <hinge>0.25</hinge>
          <y_i units="m">4.03</y_i>
          <y_o units="m">5.87</y_o>
          <bf units="m">1.84</bf>

          <!-- 3. Reference frame -->
          <x_CG units="m">2.40</x_CG>
          <y_CG units="m">0</y_CG>
          <z_CG units="m">0</z_CG>
          <x_ref units="m">0</x_ref>
          <y_ref units="m">0</y_ref>
          <z_ref units="m">0</z_ref>

          <!-- 4. Surface layout -->
          <nwing>1</nwing>
          <nelem>2</nelem>
          <symetric>1</symetric>
          <allmove>0</allmove>

          <!-- 5. Apex coordinates -->
          <startx units="m">0;3.0213955273749</startx>
          <starty units="m">0;4.315</starty>
          <startz units="m">0;0</startz>

          <!-- 6. Chord and airfoil definition -->
          <c_root units="m">4.04</c_root>
          <Airfoil>N64210.DAT;N64210.DAT</Airfoil>
          <Airfoil_root>N64210.DAT</Airfoil_root>
          <Airfoil_tip>N64210.DAT</Airfoil_tip>

          <!-- 7. Planform geometry -->
          <span units="m">4.315;1.84</span>
          <TR>0.589108910891089;0.705882352941177</TR>
          <Lambda_c4 units="deg">20;20</Lambda_c4>
          <Gamma units="deg">-3;-3</Gamma>
          <Twist units="deg">0</Twist>

          <!-- 8. Mesh settings -->
          <nx>6</nx>
          <ny>8</ny>
          <fnx>4</fnx>
          <meshtype>3;3</meshtype>

